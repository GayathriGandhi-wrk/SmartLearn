# AI Service environment configuration
# Copy to .env and fill in your API keys

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=1

# Chatbot provider: gemini | openai | rule
CHATBOT_PROVIDER=rule
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Model storage
MODEL_DIR=../models
