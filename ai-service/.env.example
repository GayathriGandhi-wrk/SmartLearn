# AI Service environment configuration
# Copy to .env and fill in your API keys

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=1

# Chatbot provider: gemini | openai | rule
CHATBOT_PROVIDER=rule
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Question generation provider: gemini | openai
QUESTION_PROVIDER=gemini
QUESTION_MODEL=gemini-1.5-flash
QUESTION_OPENAI_MODEL=gpt-4o-mini
# How much of a video transcript / page text is given to the model
QUESTION_SOURCE_CHARS=12000

# Reading the content a student learned from
CONTENT_MAX_CHARS=12000
CONTENT_FETCH_TIMEOUT=8

# Model storage
MODEL_DIR=../models
