# Node.js gateway configuration
# Copy to .env and adjust

# Server
PORT=3000
NODE_ENV=development

# Spring Boot REST API
SPRING_API_BASE=http://localhost:8080/api
SPRING_TIMEOUT_MS=30000

# JWT (shared with Spring - keep the same signing secret)
JWT_SECRET=c2VjcmV0LWtleS1mb3Itc3R1ZGVudC1wZXJmb3JtYW5jZS1zeXN0ZW0tMzItYnl0ZXMtbG9uZw==
JWT_EXPIRES_IN=24h

# Email (Gmail SMTP with app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=yourmail@gmail.com
EMAIL_PASS=your-app-password

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# YouTube Data API (Learn module)
# YouTube removed search embeds in Nov 2020, so the Learn module searches here
# for real video IDs and embeds only the video the student picks.
# Get a key at https://console.cloud.google.com -> enable "YouTube Data API v3".
# Required: with no key the search endpoint reports itself unconfigured and the
# Learn module shows no related videos.
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_MS=10000
YOUTUBE_MAX_RESULTS=8
